# FundLok local development environment
# Copy this file to .env before starting the API.

# Local Docker PostgreSQL from docker-compose.yml.
# HANDOFF-02 Fix A: the app is now async (asyncpg). Alembic intentionally
# keeps its own sync (psycopg2) URL -- when running `alembic upgrade head` /
# `alembic check` by hand, override on the command line, e.g.:
#   DATABASE_URL=postgresql+psycopg2://fundlok:fundlok@localhost:5433/fundlok_dev alembic upgrade head
DATABASE_URL=postgresql+asyncpg://fundlok:fundlok@localhost:5433/fundlok_dev

# Development only. Leave FALSE (or unset) in any deployed environment: it
# serves /docs, /redoc and /openapi.json, which publish every route and schema
# in the API.
DEBUG=False

# Auth cookies carry the Secure attribute unless this is False. The code
# defaults to True, so a deployment that omits it is the safe one; local
# development over plain http needs the opt-out (Safari refuses Secure cookies
# on http://localhost, where Chrome and Firefox accept them).
COOKIE_SECURE=False

# Generate a value with: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-string

# Who the caller is, for audit logs and the per-IP rate limiter
# (app/utils/client_ip.py). The SAME value as BACKEND_SECRET_KEY on the
# frontend: every Next -> FastAPI call sends it as X-Backend-Secret, with the
# visitor's address in X-Client-IP, and a request that carries it gets that
# address. Unset turns the header off and TRUSTED_PROXY_HOPS (below) decides.
# Locally, leave it empty unless the frontend's .env.local sets one too
BACKEND_SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Absolute cap on one sign-in, from the moment of login, however often it is
# refreshed. After this the user signs in again even if "remember me" is on.
SESSION_MAX_LIFETIME_DAYS=30
MOCK_UPLOAD_BASE_URL=https://mock-storage.fundlok.local/upload

# Where the frontend runs: the origin, no trailing slash. CORS allows it, and
# it is the base for links and redirects back to the site (the KYC callback,
# Admin > Email's Google OAuth redirect URI and the page it returns to) and the
# passkey domain. Production: https://www.fundlok.com
FRONTEND_URL=http://localhost:3000
# More browser origins allowed to call the API, comma-separated. FRONTEND_URL
# is always allowed on top of these.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# # SMTP Configurations (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=False
EMAILS_FROM_EMAIL=noreply@fundlok.com
EMAILS_FROM_NAME=FundLok
# Inbox that /contact submissions are forwarded to (Reply-To = the submitter)
CONTACT_INBOX_EMAIL=support@fundlok.com

# Redis for the per-IP rate limiter (app/core/redis_client.py). Local dev uses the
# docker-compose `redis` service. Deployed environments use Upstash
# (https://console.upstash.com) over TLS -- note `rediss://`, two s's:
#   REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
# Upstash serves database 0 only, so give staging and prod their own Upstash
# databases. The password is a secret -- it goes in .env or the
# Cloud Run service config, never in this file.
REDIS_URL=redis://localhost:6379/0

# The same Redis over Upstash's REST API, for HTTP clients (@upstash/redis,
# upstash-redis). Locally: the compose `srh` service in front of the local
# redis. Deployed: the REST URL and token from the Upstash console.
# app/core/redis_client.py uses REDIS_URL above, not these.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local_upstash_token



# Captcha (Cloudflare Turnstile). Required by default: a deployment with no
# secret REFUSES login, sign-up, password reset, contact and the rate
# calculator (503) rather than accepting every request. Local dev leaves the
# secret blank and opts out. To exercise captcha locally instead, use
# Cloudflare's always-pass test secret 1x0000000000000000000000000000000AA.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CAPTCHA_REQUIRED=False

# Per-IP rate limits (app/core/rate_limit.py), counted in Redis. Off by default.
# Do NOT turn on in a deployment until the audit log shows real visitor IPs:
#  - BACKEND_SECRET_KEY (above) is set to the frontend's value, and
#  - the frontend that sends X-Client-IP on every call, including its own
#    server-side session checks, is deployed.
# Until then every visitor arrives from Vercel's servers, shares a few
# addresses, and would be throttled together. See "Client IP" in
# docs/deployment/ci-cd-pipeline.md.
#
# TRUSTED_PROXY_HOPS is the fallback for requests without the secret: how many
# proxies APPEND to X-Forwarded-For. 0 trusts no entry and keeps the socket
# peer. Locally there is no proxy, so 0 is right and the limiter can be tried
# as is.
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_ENABLED=False
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_SENSITIVE_PER_MINUTE=20
# Cloudflare R2 (S3-compatible object storage for loan application documents).
# For local dev, point at the minio container from docker-compose.yml:
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=fundlok-uploads
# Bucket for retained KYC/KYB verification documents. Empty = R2_BUCKET.
R2_VERIFICATION_BUCKET=
R2_REGION=auto
R2_PRESIGN_EXPIRE_SECONDS=900
# Public bucket for blog images and the origin it is served from (no trailing
# slash). Locally: a minio bucket with anonymous read. Empty = blog image upload off.
R2_PUBLIC_BUCKET=fundlok-public
R2_PUBLIC_BASE_URL=http://localhost:9000/fundlok-public

# GVerify / GHub eKYC (Datatrust, API v2.5.1) — direct-API KYC provider, parallel
# to Didit. See docs/specs/gverify/ekyc-kyc-verification.md.
# GVERIFY_BASE_URL: partner-provided {api-base-url}; GVERIFY_API_KEY: x-api-key value;
# GVERIFY_PARTNER_CODE: partner/subpartner "code" sent with every request.
GVERIFY_BASE_URL=
GVERIFY_API_KEY=
GVERIFY_PARTNER_CODE=
# OCR confidence threshold (0-1). Face match has no threshold of ours — the
# verdict follows the provider's is_matching flag directly.
GVERIFY_MIN_OCR_CONFIDENCE=0.85
# KYB (business verification) — docs/specs/gverify/ekyb-kyb-verification.md
GVERIFY_MIN_KYB_OCR_CONFIDENCE=0.85
# Require the SME's KYC-verified CCCD to appear among the certificate's legal
# representatives (spec Rule 7; default off pending review).
GVERIFY_KYB_REQUIRE_REP_MATCH=false
# The os-type header sent with every GVerify request.
GVERIFY_OS_TYPE=fundlok-backend
# Face similarity (%) at or above which the portrait is taken to be the card's
# own photo resubmitted, not a live capture, and the attempt goes to a human.
# A stopgap until there is a liveness step.
GVERIFY_CARD_PHOTO_SIMILARITY=98.0
# Submissions per user per rolling 24 hours, KYC and KYB counted separately.
# Every attempt is billable provider calls.
GVERIFY_MAX_ATTEMPTS_PER_DAY=5

# Phone verification (Zalo ZBS) — docs/specs/users/phone-verification.md.
# A new account proves a Vietnamese mobile number by one-time code before it may
# choose a role. Required by default; with Zalo unconfigured the send endpoint
# answers 503, so set PHONE_VERIFICATION_REQUIRED=false to turn the gate off
# until it is in place.
PHONE_VERIFICATION_REQUIRED=true
# zalo (settings below) | log (writes the code to the server log; honoured only
# with DEBUG=True). Local development without a Zalo OA: PHONE_OTP_CHANNEL=log.
PHONE_OTP_CHANNEL=zalo

# Zalo ZBS. App ID and secret from developers.zalo.me (the app linked to the
# Official Account). ZALO_OA_REFRESH_TOKEN is the refresh token from authorising
# the app on the OA: it is used once to start, then the rotating pair lives
# encrypted in the zalo_oa_tokens table. Paste a new one here after
# re-authorising and it starts a new chain.
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_REFRESH_TOKEN=
# Fernet key for the stored tokens. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZALO_TOKEN_ENCRYPTION_KEY=
# The approved ZBS template of type OTP, and the name of its code parameter.
ZALO_ZBS_OTP_TEMPLATE_ID=
ZALO_ZBS_OTP_PARAM=otp
# true sends in Zalo's development mode: delivered only to admins of the app or
# the OA, so a template can be tried before it is approved. Off in production.
ZALO_ZBS_DEVELOPMENT_MODE=false
# The approved ZBS template for the daily repayment reminder to the SME (one
# message per investor ticket due today and not yet marked paid, sent by the
# 15:00 repayment-reminders job). Empty: no Zalo reminder.
ZALO_ZBS_REMINDER_TEMPLATE_ID=




# Encrypts TOTP (two-factor) secrets at rest. Separate from SECRET_KEY on
# purpose: sharing them would mean rotating the JWT key locks every 2FA user out
# of their authenticator app. Leave unset and 2FA enrolment is refused rather
# than storing secrets in plaintext.
#   generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# Encrypts the Google OAuth refresh token behind each admin's Gmail connection
# under Admin > Email. Its own key, separate from SECRET_KEY and
# TOTP_ENCRYPTION_KEY. Leave unset and no account can be connected (the console
# says so) rather than a token being stored in plaintext. Rotating it means
# every admin reconnects.
#   generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_SETTINGS_ENCRYPTION_KEY=

# --- Social sign-in ---
# Google sign-in: the OAuth client ID, the same value as the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID. Admin > Email (below) reuses this client when
# GOOGLE_OAUTH_CLIENT_ID is empty. Unset = Google sign-in does not work.
GOOGLE_CLIENT_ID=
# Microsoft sign-in (Entra ID). "common" lets any Entra tenant sign in.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# --- Admin > Email: Google OAuth 2.0 (Gmail API, scope gmail.send) ---
# A "Web application" OAuth client in Google Cloud Console (APIs & Services >
# Credentials). On that client's Cloud project:
#   1. Enable the Gmail API (APIs & Services > Library > Gmail API > Enable).
#      Without it every send fails with GMAIL_API_DISABLED.
#   2. Add the scope .../auth/gmail.send under Google Auth Platform > Data Access.
#   3. Register the redirect URI below under "Authorized redirect URIs",
#      EXACTLY (scheme, host, port, path).
# Leave GOOGLE_OAUTH_CLIENT_ID empty to reuse the sign-in client
# (GOOGLE_CLIENT_ID); then only that client's secret goes here. Google shows a
# secret once, when it is created: copy it then. A secret goes in .env or the
# Cloud Run service config, never in this file.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Defaults to {FRONTEND_URL}/api/admin/email/oauth/callback: Google sends the
# browser to the frontend, whose /api proxy forwards it to this API.
#   local:      http://localhost:3000/api/admin/email/oauth/callback
#   production: https://www.fundlok.com/api/admin/email/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Comma-separated domains a connected Gmail account must be on, e.g. fundlok.com.
# Empty allows any Google account.
GMAIL_CONNECT_ALLOWED_DOMAINS=

# --- Passkeys / WebAuthn ---
# The Relying Party ID is the domain a passkey is BOUND to. A credential
# registered against one RP ID cannot be used against another, so changing this
# invalidates every passkey already registered — treat it as permanent.
#
# It must be the registrable domain, with no scheme and no port
# ("fundlok.com", not "https://fundlok.com:443"). Bare IP addresses are
# rejected by the browser outright, so an app served from one cannot offer
# passkeys at all.
#
# Both are derived from FRONTEND_URL when unset, which is correct for local
# development and for any deployment where the frontend is the only origin.
# WEBAUTHN_RP_ID=fundlok.com
# WEBAUTHN_ORIGINS=https://fundlok.com,https://staging.fundlok.com
WEBAUTHN_RP_NAME=FundLok

# PartyKit live notification push (see app/notifications/realtime.py). All three
# unset = off, and the bell just polls. Local: PARTYKIT_HOST=localhost:1999 and
# `bun run dev` starts the PartyKit server for you (scripts/dev.sh; it lives in
# the frontend repo's party/ folder). Use any random strings for the secrets
# locally; deployed, they must match `partykit env`.
PARTYKIT_HOST=
PARTYKIT_JWT_SECRET=
PARTYKIT_PUBLISH_SECRET=

# FundLok's own fee-collection account, used for the payment QR on SME fee invoices
# (app/direct_transfer/config.py). Not custody. Real values live in deployment config only.
# FUNDLOK_FEE_BANK_BIN=<bank BIN, 6 digits>
# FUNDLOK_FEE_ACCOUNT_NUMBER=<account number>
# FUNDLOK_FEE_ACCOUNT_NAME=<account holder name>
